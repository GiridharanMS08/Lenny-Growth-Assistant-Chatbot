APP_ENV=development

# PostgreSQL is required for persistence.
# Change this password (or replace the whole URL) and restart the backend.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/lenny

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=3
MIN_RERANK_SCORE=0.25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

ARTIFACT_MAX_CHARS=100000

TRANSCRIPT_DIR=data/transcripts
INDEX_DIR=data/index

CORS_ORIGINS=http://localhost:5173
